# Data Agent Backend Configuration
# Copy this file to .env and update values for your environment

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Metadata database (stores conversations, traces, permissions, etc.)
META_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/data_agent

# Sample data database (user queries and results)
SAMPLE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/data_agent

# ============================================================================
# ENVIRONMENT & LOGGING
# ============================================================================

# Environment mode: development, staging, or production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================

# Authentication mode: dev, oidc, or jwt
# - dev: No authentication (development only)
# - oidc: OpenID Connect via external provider
# - jwt: JWT tokens signed with JWT_SECRET
AUTH_MODE=dev

# JWT signing secret (required for jwt and dev modes, min 24 chars in prod)
JWT_SECRET=dev-only-secret-change-in-production

# OIDC Configuration (required if AUTH_MODE=oidc)
OIDC_ISSUER=https://your-oidc-provider.com
OIDC_AUDIENCE=data-agent-api
OIDC_CLIENT_SECRET=your-client-secret
OIDC_JWKS_URL=https://your-oidc-provider.com/.well-known/openid-configuration/jwks

# ============================================================================
# CORS & API SECURITY
# ============================================================================

# Comma-separated list of allowed origins (use specific URLs in production, not *)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM API base URL
LLM_BASE_URL=https://api.openai.com/v1

# LLM API key (required in production)
LLM_API_KEY=

# LLM model name
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# ============================================================================
# PRODUCTION NOTES
# ============================================================================
# When deploying to production:
# 1. Set ENVIRONMENT=production
# 2. Set AUTH_MODE=oidc with valid OIDC provider config
# 3. Use strong JWT_SECRET (min 24 chars, no "dev-only")
# 4. Use separate database credentials for META and SAMPLE databases
# 5. Remove default postgres:postgres credentials
# 6. Set specific CORS_ORIGINS (no wildcards, no localhost)
# 7. Run migrations: python scripts/migrate.py
# 8. Verify startup probes: GET /livez and GET /readyz
